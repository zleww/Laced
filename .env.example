# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings > API). Fake values below.

# Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (starts with sb_publishable_), or the legacy "anon" key.
# This key is meant to be public; row-level security is what protects the data.
# NEVER put the secret / service_role key in any VITE_ variable: Vite ships
# every VITE_ variable to the browser.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Optional: the email address the public front page's "Request a demo" button
# writes to. Leave it out to show only "Sign in".
VITE_CONTACT_EMAIL=you@example.com
